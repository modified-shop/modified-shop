{
    "account": {
        "headline": "idealo Account",
        "fields": {
            "csvpath": []
        }
    },
    "directbuyactivation": {
        "headline": "idealo Direktkauf",
        "fields": {
            "directbuyactive": {
                "key": "idealo.directbuy.active",
                "label": "Use idealo Direktkauf",
                "desc": "Select here whether you want to use idealo Direktkauf.\r\n<br><br>\r\nIf you click “Yes”, follow these steps to obtain credentials for the idealo Direktkauf Merchant Order API v2:\r\n<ul>\r\n<li>\r\nLog in to your <a target=\"_blank\" href=\"https:\/\/business.idealo.com\/\">idealo Business Account<\/a>.\r\n<\/li><li>\r\nNavigate to “Direktkauf” -> “Integration” -> “Create new API client”\r\n<\/li><li>\r\nSelect the option “Create new productive client”\r\n<\/li><li>\r\nCopy and save the generated “Client ID” and “Client password”\r\n<\/li>\r\n<\/ul>\r\nNow you can enter the values into the fields “idealo Direktkauf Client ID” and “idealo Direktkauf password” in the magnalister idealo configuration and click “Save data”.",
                "type": "radio",
                "values": {
                    "true": "Yes",
                    "false": "No"
                },
                "default": "false",
                "submit": "Access.DirectCheckoutActive"
            },
            "directbuyclientid": {
                "label": "idealo Direktkauf “Client ID”",
                "key": "idealo.directbuy.clientid",
                "desc": "Enter the “Client ID” here that you generated via your idealo Business Account under “Direktkauf” -> “Integration” -> “Create new API client”.\r\n<br><br>\r\nFurther information can be found in the info icon next to “Use idealo Direktkauf”.",
                "type": "text",
                "parameters": {
                    "data-direct": "true"
                }
            },
            "idealodirectbuypassword": {
                "label": "idealo Direktkauf “Client password”",
                "key": "idealo.directbuy.password",
                "desc": "Enter the “Client password” here that you generated via your idealo Business Account under “Direktkauf” -> “Integration” -> “Create new API client”.\r\n<br><br>\r\nFurther information can be found in the info icon next to “Use idealo Direktkauf”.",
                "type": "password",
                "settings": {
                    "save": false
                },
                "parameters": {
                    "data-direct": "true"
                }
            }
        }
    },
    "lang": {
        "headline": "Language settings",
        "fields": {
            "lang": {
                "label": "Item description",
                "key": "idealo.lang",
                "type": "selection",
                "values": null
            }
        }
    },
    "prepare": {
        "headline": "Item preparation",
        "fields": {
            "filter": {
                "label": "Status filter",
                "key": "_#_platform_#_.prepare.status",
                "type": "checkbox",
                "values": {
                    "val": "only transfer active items"
                },
                "default": {
                    "val": false
                }
            }
        }
    },
    "shop": {
        "headline": "Upload items: defaults",
        "fields": {
            "statusfilter": {
                "label": "Status filter",
                "key": "idealo.checkin.status",
                "desc": "In the web shop you can set items active or inactive. Depending on the setting here, only active items will be shown during preparation and product upload.",
                "type": "checkbox",
                "values": {
                    "val": "only transfer active items"
                },
                "default": {
                    "val": false
                }
            },
            "paymentmethods": {
                "label": "Payment method",
                "desc": "Specify the desired default payment methods for the comparison shopping portal here (multiple selection possible).<br \/>You can adjust the payment methods at any time individually for the products to be prepared under \"Prepare products\".",
                "key": "idealo.payment.methods",
                "type": "multiselection",
                "parameters": {
                    "size": "12"
                },
                "values": {
                    "PAYPAL": "PayPal",
                    "CREDITCARD": "Credit card",
                    "SOFORT": "Sofortüberweisung",
                    "PRE": "Payment in advance",
                    "COD": "Cash on delivery",
                    "BANKENTER": "Direct debit",
                    "BILL": "Invoice",
                    "GIROPAY": "Giropay",
                    "CLICKBUY": "Click&Buy",
                    "SKRILL": "Skrill"
                }
            },
            "quantity": {
                "label": "Stock",
                "desc": "idealo only knows the stock states \"available\" or \"not available\". Specify here whether stock should be available on the marketplace according to your shop stock.<br \/><br \/>To avoid overselling, you can activate the value \"Use shop stock minus value from the right field\".<br \/><br \/><b>Example:<\/b> Set value to \"2\". Result → shop stock: 2 → idealo.de stock: item not available (0).<br \/><br \/> <b>Note:<\/b> If you want items that are set inactive in the shop to be treated as stock \"0\" on the marketplace regardless of the stock quantity used, please proceed as follows:<br \/><ul><li>Set \"Inventory synchronisation\" > \"Stock change shop\" to \"automatic synchronisation via CronJob\"<\/li><li>Activate \"Global configuration\" > \"Product status\" > \"If product status is inactive, treat stock as 0\"<\/li><\/ul>",
                "key": "idealo.quantity.type",
                "type": "selection",
                "values": {
                    "stock": "Use shop stock",
                    "stocksub": "Use shop stock minus value from the right field",
                    "lump": "Flat rate (from right field)"
                },
                "default": "stock",
                "morefields": {
                    "quantity": {
                        "key": "idealo.quantity.value",
                        "type": "text",
                        "default": 0,
                        "verify": "int",
                        "cssClasses": [
                            "autoWidth"
                        ]
                    }
                }
            },
            "mfnpartno": {
                "label": "Manufacturer part number",
                "desc": "If you use a contrib to manage manufacturer part numbers, you can select the table and column here in which the\n\t\t\t\t           manufacturer part number is stored. This will pre-fill the field for manufacturer part numbers during preparation. <br\/>\n\t\t\t\t           If the column \"products_id\" in the table is named differently, please specify the alternative name with the same\n\t\t\t\t           meaning under Alias.<br\/><br\/>\n\t\t\t\t           <b>Note:<\/b> This data will not be validated. If it is incorrect, database errors will occur!",
                "key": "comparisonshopping.checkin.manufacturerpartnumber.table",
                "type": "dbfieldselector",
                "expertsetting": true,
                "morefields": {
                    "alias": {
                        "label": "<span class=\"tt\">`products_id`<\/span> alias",
                        "key": "comparisonshopping.checkin.manufacturerpartnumber.alias",
                        "type": "text",
                        "cssClasses": [
                            "autoWidth"
                        ]
                    }
                }
            },
            "imagepath": {
                "label": "Image directory",
                "key": "idealo.imagepath",
                "type": "text",
                "expertsetting": true,
                "desc": "Directory from which the product images should be taken."
            }
        }
    },
    "preparedirect": {
        "headline": "",
        "desc": "<b>Direktkauf<\/b>",
        "fields": {
            "maxquantity": {
                "label": "Order limit per calendar day",
                "desc": "Order limit per calendar day for Direktkauf:<br \/><br \/>You can specify here how many items per calendar day may be sold via Direktkauf. Without this specification, the item remains available in Direktkauf until the offer is either deleted or settings are changed.<br \/><br \/>Please note: This field should not be confused with your stock. This is about a daily limit which is determined for idealo Direktkauf.<br \/><br \/><p style=\"color:red;\"><b>Note:<\/b><br \/>Settings under \"Stock quantity\" are taken into account up to the order limit set here.<br \/><br \/>If the \"quantity\" setting \"Flat rate (from right field)\" is activated, the limit has no effect.<\/p>",
                "key": "idealo.quantity.maxquantity",
                "type": "text",
                "default": "",
                "cssClasses": [
                    "autoWidth"
                ],
                "parameters": {
                    "data-direct": "true"
                }
            }
        }
    },
    "shipping": {
        "headline": "Shipping details",
        "desc": "Defines the shipping settings used when listing products on this marketplace.",
        "fields": {
            "country": {
                "label": "Shipping to",
                "key": "idealo.shipping.country",
                "type": "selection",
                "values": null
            },
            "method": {
                "label": "Shipping costs",
                "desc": "Enter the flat-rate shipping costs for your items here. In the product preparation you can save the values individually for the selected items.",
                "key": "idealo.shipping.method",
                "type": "selection",
                "values": null,
                "hint": "Example: 6.70 (without specifying a currency)",
                "morefields": {
                    "cost": {
                        "label": "Shipping costs",
                        "key": "idealo.shipping.cost",
                        "type": "text",
                        "default": "6.70",
                        "verify": "float",
                        "cssClasses": [
                            "autoWidth"
                        ],
                        "rightlabel": "const(DEFAULT_CURRENCY)",
                        "formatstr": "%.2f"
                    }
                }
            },
            "deliverytime": {
                "label": "Delivery time",
                "desc": "Please specify delivery times as precisely as possible. Online retailers are\nlegally obliged to inform the consumer, based on the delivery time information,\nwhen the goods will arrive. As a result, the still widespread information such as\n„ready to ship“ or „available“ is no longer permitted. Likewise, no relativising\nadditions such as „probably“ or „usually“ may be used. Please therefore specify\ndelivery times in working days where possible, e.g. “Delivery in 1-3 working days”.",
                "key": "_#_platform_#_.deliverytime",
                "type": "text",
                "cssClasses": [
                    "autoWidth"
                ],
                "values": null
            }
        }
    },
    "shippingdirect": {
        "desc": "<b>Direktkauf<\/b>",
        "fields": {
            "shippingmethods": {
                "label": "Shipping method",
                "desc": "Specify here which shipping method should apply to your Direktkauf offers.",
                "key": "_#_platform_#_.shipping.methods",
                "type": "selection",
                "parameters": {
                    "data-direct": "true"
                },
                "values": {
                    "Paketdienst": "Parcel service",
                    "Spedition": "Spedition",
                    "Download": "Download"
                }
            },
            "twomanhandlingfee": {
                "label": "Direktkauf Spedition - Delivery cost to placement location",
                "desc": "The cost for this service are only submited to Idealo if the shipping method is \"Spedition\". In case you submit the value of 0.00 it means that the service is free of charge.",
                "key": "_#_platform_#_.shipping.methods.twomanhandlingfee",
                "type": "text",
                "rightlabel": "const(DEFAULT_CURRENCY)",
                "cssClasses": [
                    "autoWidth"
                ],
                "parameters": {
                    "data-direct": "true",
                    "data-fulfillment": "Spedition"
                },
                "formatstr": ""
            },
            "disposalfee": {
                "label": "Direktkauf Spedition - Cost of old appliance pickup",
                "desc": "The cost for this service are only submited to Idealo if the shipping method is \"Spedition\". In case you submit the value of 0.00 it means that the service is free of charge.",
                "key": "_#_platform_#_.shipping.methods.disposalfee",
                "type": "text",
                "rightlabel": "const(DEFAULT_CURRENCY)",
                "cssClasses": [
                    "autoWidth"
                ],
                "parameters": {
                    "data-direct": "true",
                    "data-fulfillment": "Spedition"
                },
                "formatstr": ""
            }
        }
    },
    "price": {
        "headline": "Price calculation",
        "fields": {
            "whichprice": {
                "label": "Price options",
                "leftlabel": "Price from customer group",
                "desc": "With this function you can submit different prices to idealo and have them synchronised automatically. To do this, set up corresponding customer groups in your web shop. If you do not enter a price in the new customer group, the standard price from the web shop is used automatically. This makes it very easy to set a different price even for just a few items.<br \/>The other price configurations are also applied.<br \/><br \/>Example:<ul><li>Set up a customer group \"idealo customers\" in your web shop<\/li><li>Add the desired prices to the items in the new customer group in your web shop.<\/li><\/ul>",
                "key": "idealo.price.group",
                "type": "selection",
                "values": null,
                "cssClasses": [
                    "rightSpacer"
                ],
                "morefields": {
                    "cost": {
                        "key": "idealo.price.usespecialoffer",
                        "type": "checkbox",
                        "values": {
                            "val": "also use special prices"
                        },
                        "default": {
                            "val": false
                        }
                    }
                }
            },
            "specialprices": {
                "label": "Special prices",
                "key": "idealo.price.usespecialoffer",
                "type": "checkbox",
                "values": {
                    "val": "also use special prices"
                },
                "default": {
                    "val": false
                }
            },
            "exchangerate": {
                "label": "Exchange rate",
                "desc": "<b>In general:<\/b><br \/> <br \/> If the web shop default currency differs from the marketplace currency, magnalister calculates during order import and item upload using the exchange rate stored in the web shop.<br \/> When importing orders, magnalister behaves 1:1 when saving the currencies and amounts as the web shop creates them on order receipt.<br \/> <br \/> <b>Attention:<\/b><br \/> <br \/> By activating this function here, the <span style='color:red'>exchange rate stored in the web shop is updated with the current rate from Yahoo Finance<\/span>. As a result, <span style='color:red'>the prices in your web shop<\/span> are also displayed with the updated exchange rate for sale.<br \/> <br \/> The following functions trigger the update:<ul> <li>Order import<\/li> <li>Item preparation<\/li> <li>Item upload<\/li> <li>Stock\/price synchronisation<\/li> <\/ul><br \/> If the exchange rate of a marketplace is not configured in the web shop's currency configuration, magnalister returns an error.<br \/> <br \/> <b>Liability notice:<\/b><br \/> RedGecko GmbH assumes no liability for the correctness of the exchange rate. Please check the submitted values in your idealo.de account.",
                "key": "idealo.exchangerate",
                "type": "checkbox",
                "values": {
                    "update": "Update exchange rate automatically"
                },
                "default": {
                    "update": false
                }
            }
        }
    },
    "orders": {
        "headline": "Order import Direktkauf",
        "fields": {
            "doimport": {
                "label": "Activate import",
                "desc": "Should orders be imported from idealo.de? <br\/><br\/>If the function is activated, orders\n\t\t\t\t           are imported hourly by default.<br><br>\n\t\t\t\t\t\t   You can determine the times for the automatic order imports yourself under<br> \n\t\t\t\t\t\t   \"magnalister Admin\" → \"Global configuration\" → \"Order retrievals\".<br><br>\n\t\t\t\t\t\t   You can trigger a manual import by clicking the corresponding function button in the \n\t\t\t\t\t\t   header of magnalister (left of the ant).<br><br>\n\t\t\t\t\t\t   In addition, you can also trigger order import (from Flat tariff onwards - max. every quarter hour) via\n\t\t\t\t\t\t   your own CronJob by calling the following link to your shop: <br>\n    \t\t\t           <i>http:\/\/www.YourShop.de\/magnaCallback.php?do=ImportOrders<\/i><br><br>\n    \t\t\t           Custom CronJob calls by customers not on the Flat tariff, or running more frequently than every quarter hour,\n    \t\t\t           are blocked.\t\t\t\t\t\t   \n\t\t\t\t\t\t   ",
                "key": "idealo.import",
                "type": "radio",
                "values": {
                    "true": "Yes",
                    "false": "No"
                },
                "default": "true",
                "submit": "Orders.Import",
                "morefields": {
                    "preimportsince": {
                        "label": "first import from",
                        "desc": "Start time from which the orders should be imported initially. Please note that this\n\t\t\t\t\t\t           cannot be arbitrarily far in the past, since the data at idealo.de\n\t\t\t\t\t\t           is only available for a few weeks at most.",
                        "key": "idealo.preimport.start",
                        "type": "date",
                        "default": "now",
                        "submit": "Orders.Import.Start",
                        "cssClasses": [
                            "autoWidth",
                            "rightSpacer"
                        ],
                        "parameters": {
                            "data-direct": "true"
                        }
                    }
                },
                "parameters": {
                    "data-direct": "true"
                }
            },
            "onlycomplete": false,
            "customersgroup": {
                "label": "Customer group",
                "desc": "Customer group to which customers are assigned for new orders.<br><br>\n                                <b>Note:<\/b> If you choose the customer group &quot;Guest&quot;, the customer account is deleted immediately after the order is created.",
                "key": "idealo.CustomerGroup",
                "type": "selection",
                "values": null,
                "default": "2",
                "parameters": {
                    "data-direct": "true"
                }
            },
            "unpaidsatus": false,
            "openstatus": {
                "label": "Order status in shop",
                "desc": "The status that an order newly received from idealo.de should automatically receive in the shop. <br\/>\n\t\t\t\t           If you use a connected dunning system, it is recommended to set the order status to \"Paid\"\n\t\t\t\t           (Configuration → Order status).",
                "key": "idealo.orderstatus.open",
                "type": "selection",
                "values": null,
                "default": "2",
                "parameters": {
                    "data-direct": "true"
                }
            },
            "defaultshipping": {
                "label": "Shipping method of orders",
                "desc": "Shipping method assigned to all idealo.de orders. Default: \"marketplace\".<br><br>\n\t\t\t\t           This setting is important for invoice and delivery note printing as well as for subsequent\n\t\t\t\t           order processing in the shop and some ERP systems.",
                "key": "idealo.orderimport.shippingmethod",
                "type": "selection",
                "values": {
                    "textfield": "From text field"
                },
                "default": "textfield",
                "expertsetting": true,
                "morefields": {
                    "quantity": {
                        "key": "idealo.orderimport.shippingmethod.name",
                        "type": "text",
                        "default": "marketplace",
                        "cssClasses": [
                            "autoWidth"
                        ],
                        "parameters": {
                            "data-direct": "true"
                        }
                    }
                },
                "parameters": {
                    "data-direct": "true"
                }
            },
            "defaultpayment": {
                "label": "Payment method of orders",
                "desc": "Payment method assigned to all _#_platformName_#_ orders. Default: \"marketplace\".<br><br>\\n\\t\\t\\t\\t           This setting is important for invoice and delivery note printing as well as for subsequent\\n\\t\\t\\t\\t           order processing in the shop and some ERP systems.",
                "key": "_#_platform_#_.orderimport.paymentmethod",
                "type": "selection",
                "values": {
                    "textfield": "From text field"
                },
                "default": "textfield",
                "expertsetting": true,
                "morefields": {
                    "quantity": {
                        "key": "_#_platform_#_.orderimport.paymentmethod.name",
                        "type": "text",
                        "default": "marketplace",
                        "cssClasses": [
                            "autoWidth"
                        ],
                        "parameters": {
                            "data-direct": "true"
                        }
                    }
                },
                "parameters": {
                    "data-direct": "true"
                }
            },
            "vat_unknown": {
                "label": "VAT for items not in shop",
                "desc": "If the item number of a purchase is not recognised in the web shop during order import, the VAT cannot be calculated.<br \/>As a solution, the value specified here in percent is used for all products whose VAT rate is not known when importing orders from idealo.",
                "hint": "Tax rate used for items not in shop on order import, in %.",
                "key": "idealo.mwst.fallback",
                "type": "text",
                "default": "19",
                "verify": "float",
                "parameters": {
                    "data-direct": "true"
                }
            }
        }
    },
    "orderSyncState": {
        "headline": "Order status Direktkauf",
        "fields": {
            "syncstatus": {
                "label": "Status synchronisation",
                "desc": "<dl>\n\t\t\t\t\t\t\t\t<dt>Automatic synchronisation via CronJob (recommended)<\/dt>\n\t\t\t\t\t\t\t\t\t<dd>The function \"Automatic synchronisation via CronJob\" transmits the current shipped status to idealo.de every 2 hours.<br\/>\n\t\t\t\t\t\t\t\t\t\tThe status values are checked and adopted from the database, even if the changes were made only in the database, e.g. by an ERP system.<br\/><br\/>\n\t\t\t\t\t\t\t\t\t\tYou can trigger a manual sync by editing the order directly in the web shop, setting the desired status there, and clicking \"Update\".<br\/>\n\t\t\t\t\t\t\t\t\t\tYou can also click the corresponding function button in the magnalister header (left of the ant) to submit the status immediately.<br\/><br\/>\n\t\t\t\t\t\t\t\t\t\tIn addition, you can trigger order status sync (from Premium tariff onwards - max. every quarter hour) via your own CronJob by calling the following link to your shop: <br\/><br\/>\n\t\t\t\t\t\t\t\t\t\t<i>http:\/\/www.YourShop.de\/magnaCallback.php?do=SyncOrderStatus<\/i><br\/><br\/>\n\t\t\t\t\t\t\t\t\t\tCustom CronJob calls by customers not on the Premium tariff, or running more frequently than every quarter hour, are blocked.\n\t\t\t\t\t\t\t\t\t<\/dd>\n\t\t\t\t\t\t\t\t<!--<dt>Synchronisation via web shop<\/dt>\n\t\t\t\t\t\t\t\t\t<dd>With this function the order status is transmitted directly and exclusively via editing the order in the web shop\n\t\t\t\t\t\t\t\t\t(not via a connected ERP system) as soon as you select the corresponding status and click \"Update\".<\/dd>-->\n\t\t\t\t\t\t\t<\/dl>\n\t\t\t\t",
                "key": "idealo.orderstatus.sync",
                "type": "selection",
                "values": {
                    "auto": "Automatic synchronisation via CronJob (recommended)",
                    "no": "No synchronisation"
                },
                "default": "auto",
                "parameters": {
                    "data-direct": "true"
                }
            },
            "shippedstatus": {
                "label": "Confirm shipping with",
                "desc": "Set the shop status here that should automatically set the status \"Shipped\" on idealo.",
                "key": "idealo.orderstatus.shipped",
                "type": "selection",
                "values": null,
                "parameters": {
                    "data-direct": "true"
                }
            },
            "carrier": {
                "label": "Carrier",
                "desc": "Pre-selected carrier when confirming shipping to idealo (can be extended via expert settings under carrier matching).",
                "key": "idealo.orderstatus.carrier.default",
                "type": "text",
                "values": null,
                "parameters": {
                    "data-direct": "true"
                }
            },
            "carrierMatch": {
                "label": "Carrier matching",
                "desc": "When transmitting the shipped status, the carrier stored under \"Order status Direktkauf\" is automatically transmitted to the marketplace. Via this setting you can match the carrier to a database field instead, in which you have stored the carrier individually for each order (the order ID must also be provided in the table).<br \/><br \/>If no carrier is found in the selected database field, the carrier specified under \"Order status Direktkauf\" is automatically used when transmitting the shipped status.",
                "key": "idealo.orderstatus.carrier.dbmatching.table",
                "type": "dbfieldselector",
                "expertsetting": true,
                "morefields": {
                    "alias": {
                        "label": "<span class='tt'>`orders_id`<\/span> alias",
                        "key": "idealo.orderstatus.carrier.dbmatching.alias",
                        "type": "text",
                        "cssClasses": [
                            "autoWidth"
                        ]
                    }
                }
            },
            "trackingmatch": {
                "label": "Tracking code matching",
                "desc": "This allows you to match any database field that contains the tracking code. The prerequisite is that the orders_id is also stored in the table. If the order id is named differently, you can enter the corresponding value in the right-hand field \"orders_id alias\".",
                "key": "idealo.orderstatus.trackingcode.dbmatching.table",
                "type": "dbfieldselector",
                "expertsetting": true,
                "morefields": {
                    "alias": {
                        "label": "<span class='tt'>`orders_id`<\/span> alias",
                        "key": "idealo.orderstatus.trackingcode.dbmatching.alias",
                        "type": "text",
                        "cssClasses": [
                            "autoWidth"
                        ],
                        "parameters": {
                            "data-direct": "true"
                        }
                    }
                },
                "parameters": {
                    "data-direct": "true"
                }
            },
            "cancelstatus": {
                "label": "Cancel order with",
                "desc": "Select the shop status here that should automatically transmit the status \"Order cancelled\" to idealo.<br \/><br \/><strong>Note:<\/strong> Partial cancellation is not possible here. The entire order is cancelled via this function.",
                "key": "idealo.orderstatus.cancelled",
                "type": "selection",
                "values": null,
                "parameters": {
                    "data-direct": "true"
                }
            },
            "cancelreaason": {
                "label": "Order cancellation reason",
                "desc": "Select the default cancellation reason here:<ul><li>\"Customer revocation\"<\/li><li>\"Merchant cannot deliver\"<\/li><li>\"Return\"<\/li><\/ul>",
                "key": "idealo.orderstatus.cancelreason",
                "type": "selection",
                "values": null,
                "parameters": {
                    "data-direct": "true"
                }
            },
            "cancelcomment": {
                "label": "Order cancellation comment",
                "key": "idealo.orderstatus.cancelcomment",
                "type": "text",
                "parameters": {
                    "data-direct": "true",
                    "maxlength": 250
                }
            },
            "refundstatus": {
                "label": "Request refunds with:",
                "desc": "With the shop order status selected here, a merchant can initiate a refund for an order that was made with “Idealo Direktkauf Payments”.\r\n<br><br>\r\nOrders that were made with other payment methods (e.g. PayPal) must continue to be managed manually and are not refunded via idealo.",
                "key": "idealo.orderstatus.refund",
                "type": "selection",
				"default": "--",
                "parameters": {
                    "data-direct": "true"
                }
            }
        }
    },
    "inventoryupdate": {
        "headline": "Inventory synchronisation",
        "desc": "Defines which product properties of the product in this shop should also be automatically updated at idealo.de.",
        "fields": [
            {
                "label": "Stock change from shop",
                "desc": "<b>Note:<\/b> Since idealo only knows \"available\" or \"not available\" for your offers, the following applies:<br \/><br \/><ul><li>Shop stock > 0 = available on idealo<\/li><li>Shop stock < 1 = not available on idealo<\/li><\/ul><br \/>Function:<br \/>Automatic synchronisation via CronJob (recommended)<br \/><br \/><br \/>The function \"Automatic synchronisation\" matches the current idealo stock to the shop stock every 4 hours*<br \/><br \/><br \/>The values are checked and adopted from the database, even if the changes were made only in the database, e.g. by an ERP system.<br \/> <br \/>You can trigger a manual sync by clicking the corresponding function button in the magnalister header (left of the ant).<br \/> <br \/>In addition, you can trigger stock sync (from Flat tariff onwards - max. every quarter hour) via your own CronJob by calling the following link to your shop:<br \/><i>http:\/\/www.YourShop.de\/magnaCallback.php?do=SyncInventory<\/i><br \/><br \/>Custom CronJob calls by customers not on the Flat tariff, or running more frequently than every quarter hour, are blocked.<br \/><br \/><br \/><br \/><b>Note:<\/b> The settings under \"Configuration\" → \"Listing process\" ...<br \/><br \/>→ \"Order limit per calendar day\" and<br \/>→ \"Stock quantity\" for the first two options.<br \/><br \/>… are taken into account.<br \/>",
                "key": "idealo.stocksync.tomarketplace",
                "type": "selection",
                "values": {
                    "auto": "Automatic synchronisation via CronJob (recommended)",
                    "no": "No synchronisation"
                },
                "default": "auto"
            },
            {
                "label": "Order import from _#_platformName_#_",
                "desc": "If e.g. an item is purchased 3 times on _#_platformName_#_, the stock in the shop is reduced by 3.<br \/><br \/>\n              <strong>Important:<\/strong> This function only runs if you have activated order import!",
                "key": "_#_platform_#_.stocksync.frommarketplace",
                "type": "selection",
                "values": {
                    "rel": "Order reduces shop stock (recommended)",
                    "no": "No synchronisation"
                },
                "default": "rel",
                "parameters": {
                    "data-direct": "true"
                }
            },
            {
                "label": "Item price",
                "desc": "<dl>\n\t\t\t\t\t\t\t\t<dt>Automatic synchronisation via CronJob (recommended)<\/dt>\n\t\t\t\t\t\t\t\t    <dd>The function \"Automatic synchronisation\" matches the current _#_platformName_#_ price to your shop price every 4 hours (starts at midnight).<br>\n    \t\t\t                        The values are checked and adopted from the database, even if the changes were made only in the database, e.g. \n    \t\t\t                        by an ERP system.<br><br>\t\t                        \n    \t\t\t                        You can trigger a manual sync by clicking the corresponding function button in the magnalister header (left of the ant).<br><br>\n    \t\t\t                        In addition, you can trigger price sync (from Flat tariff onwards - max. every quarter hour) via your own CronJob\n    \t\t\t                        by calling the following link to your shop: <br>\n    \t\t\t                        <i>http:\/\/www.YourShop.de\/magnaCallback.php?do=SyncInventory<\/i><br>\n    \t\t\t                        Custom CronJob calls by customers not on the Flat tariff, or running more frequently than every quarter hour, are blocked.   \t\t\t                        \n    \t\t\t                        <\/dd>\n\t\t\t\t\t\t\t<\/dl><br>\n\t\t\t\t\t\t\t<b>Note:<\/b> The settings under \"Configuration\" → \"Price calculation\" are taken into account.\n\t\t\t\t",
                "key": "idealo.inventorysync.price",
                "type": "selection",
                "values": {
                    "auto": "Automatic synchronisation via CronJob (recommended)",
                    "no": "No synchronisation"
                },
                "default": "auto"
            }
        ]
    },
    "stats": {
        "headline": "Statistics settings (optional)",
        "fields": {
            "mtlcost": {
                "label": "Monthly base fee",
                "desc": "If no monthly fees are due, enter \"0.0\" in the field.",
                "key": "idealo.cost.montly",
                "type": "text",
                "default": "0.0",
                "verify": "float",
                "cssClasses": [
                    "autoWidth"
                ],
                "rightlabel": "const(DEFAULT_CURRENCY)",
                "formatstr": "%.2f"
            },
            "clickcost": {
                "label": "Cost per click",
                "desc": "If there are no costs per click, enter \"0.0\" in the field.",
                "key": "idealo.cost.click",
                "type": "text",
                "default": "0.0",
                "verify": "float",
                "cssClasses": [
                    "autoWidth"
                ],
                "rightlabel": "const(DEFAULT_CURRENCY)",
                "formatstr": "%.2f"
            },
            "campaign": {
                "label": "Campaign link",
                "desc": "To create a campaign link that can be tracked specifically, please enter a string without\n\t\t\t\t           special characters (e.g. umlauts, punctuation marks and spaces), such as \"allesmussraus\".",
                "key": "idealo.campaignlink",
                "verify": "regex(\"[A-Za-z0-9]*\")",
                "type": "text"
            }
        }
    }
}
