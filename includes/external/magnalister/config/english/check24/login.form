{
    "login": {
        "headline": "_#_platformName_#_ Zugangsdaten",
        "fields": {
            "0": {
                "label": "Benutzername",
                "desc": "Die Zugangsdaten für die Check24 Schnittstelle finden Sie nach dem Login auf Check24 unter \"Einstellungen\" -> \"Bestellübermittlung\" -> Konfiguration und dort in der Sektion \"Ihre Schnittstellen-Zugangsdaten\".",
                "key": "_#_platform_#_.access.MPUSERNAME",
                "type": "text"
            },
            "1": {
                "label": "Passwort",
                "key": "_#_platform_#_.access.MPPASSWORD",
                "type": "password",
                "settings": {
                    "save": false
                }
            },
            "inventorypath": {
                "label": "Pfad zu Ihrer CSV-Tabelle",
                "key": "_#_platform_#_.access.InventoryPath",
                "type": "html",
                "settings": {
                    "save": false
                }
            }
        }
    }
}
