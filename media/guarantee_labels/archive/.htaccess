#
# This is used with Apache WebServers
# The archive holds the historical label, notice and guarantee condition files of existing orders.
# PHP reads them locally for the order confirmation, direct HTTP requests are blocked.

# OpenLiteSpeed reads an .htaccess for rewrite rules only and ignores the block below. This one
# does the same job with the directive it does read, so a shop that enabled .htaccess there is
# locked as well. The module diagnosis still names the server, the rule may be switched off.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ - [F]
</IfModule>

<FilesMatch ".*">
  <IfModule mod_authz_core.c>
    # Apache 2.4
    <RequireAll>
      Require all denied
    </RequireAll>
  </IfModule>
  <IfModule !mod_authz_core.c>
    # Apache 2.2
    Order Deny,Allow
    Deny from all
  </IfModule>
</FilesMatch>
